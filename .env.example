# Copy this file to .env and replace every placeholder locally.
# Never commit .env or expose service-role credentials to the browser.

GEMINI_API_KEY=your_google_ai_studio_api_key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional direct Postgres connection parameters. The current pipeline uses
# the Supabase API URL and service-role key for app/pipeline access.
SUPABASE_DB_HOST=your-project.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your_supabase_database_password
